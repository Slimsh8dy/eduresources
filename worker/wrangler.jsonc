{
  // EduResources tutor — Cloudflare Worker. Deploy with `npx wrangler deploy` from this folder,
  // or paste worker/dist/tutor.js into a Worker created in the Cloudflare dashboard.
  "$schema": "https://developers.cloudflare.com/workers/wrangler-config.json",
  "name": "eduresources-tutor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "MODEL": "@cf/openai/gpt-oss-120b",
    "ALLOWED_ORIGINS": "https://slimsh8dy.github.io,http://localhost:4173,http://127.0.0.1:4173"
  }
}
